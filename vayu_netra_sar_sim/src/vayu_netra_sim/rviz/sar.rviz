Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Global Options:
    Fixed Frame: map
    Background Color: 15; 25; 35
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground grid
      Value: true
      Plane Cell Count: 80
      Cell Size: 1
    - Class: rviz_default_plugins/MarkerArray
      Name: SAR markers and grid
      Value: true
      Marker Topic:
        Value: /vayu/map_markers
